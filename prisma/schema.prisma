// Prisma schema for the SAT prep platform.
//
// Local development uses SQLite (zero setup, just a file on disk).
// For production deployment (e.g. Vercel), switch the datasource below to
// Postgres and point DATABASE_URL at a hosted database (Neon, Supabase, etc).
// See README.md for exact steps -- it's a one-line change, not a rewrite,
// because Prisma's query API is the same across both databases.

datasource db {
  provider  = "postgresql"
  // Pooled (pgbouncer, transaction mode) for the app at runtime; migrations
  // use directUrl since pgbouncer's transaction mode doesn't support the
  // session-level features `prisma migrate` needs.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  passwordHash String
  createdAt DateTime   @default(now())
  progress  Progress[]
  practiceTests PracticeTest[]

  // Daily practice streak (consecutive calendar days with at least one quiz
  // submission). Computed in app/api/progress/route.ts on each submission.
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastActiveDate DateTime?

  // Study goals: a baseline score, target score, and SAT test date, used to
  // build a custom-length timeline in place of the default 6-month plan.
  baselineScore  Int?
  goalScore      Int?
  targetTestDate DateTime?

  // Which unlocked wardrobe costume (see lib/costumes.ts) Ozho is currently
  // wearing -- null/"none" means bare. Unlocking is computed live from star
  // totals, never stored; this only remembers the student's own pick among
  // whatever they've unlocked.
  equippedCostume String?

  // Onboarding: null means "never seen the welcome page" (new signups land
  // there once); existing users are backfilled to non-null so they aren't
  // suddenly routed into it. Login timestamps power the "welcome back,
  // here's what you did last time" summary on the dashboard.
  welcomeSeenAt  DateTime?
  lastLoginAt    DateTime?
  previousLoginAt DateTime?

  // Study-streak pet: dies if the student goes 7 days without completing a
  // quiz (see lib/pet.ts). petBornAt resets when a new pet is started after
  // a death; the two "sent" timestamps stop the daily cron from re-sending
  // the same warning/death email more than once.
  petDiedAt              DateTime?
  petBornAt              DateTime  @default(now())
  petWarningEmailSentAt  DateTime?
  petDeathEmailSentAt    DateTime?

  // Parent access: a student generates each of these on demand from
  // Settings (both start null). parentInviteCode is a short code a parent
  // types in during their own signup to link their account to this
  // student's -- see ParentLink. parentShareToken is a separate,
  // unguessable token for the no-login public read-only view at
  // /share/[token] (app/share/[token]/page.tsx). Neither is required for
  // the app to work exactly as it does today.
  parentInviteCode String?      @unique
  parentShareToken String?      @unique
  parentLinks      ParentLink[]

  // Billing. stripeCustomerId is set the first time this student starts a
  // checkout, for either purchase path below, and is reused after that.
  // Subscription path (Monthly/Annual prices): subscriptionStatus mirrors
  // Stripe's own status string verbatim ("trialing", "active", "past_due",
  // "canceled", etc. -- see lib/subscription.ts) and is the source of
  // truth for access; currentPeriodEnd is display-only ("renews on...").
  // One-time path (the 6-Month Pass): accessExpiresAt is simply set to
  // purchase time + 182 days on a successful payment -- independent of
  // subscriptionStatus, since a one-time payment has no Stripe Subscription
  // object behind it at all. A student can hold both at once (e.g. bought
  // the pass, later also subscribes); access is granted if EITHER is
  // currently valid -- see hasActiveAccess.
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  subscriptionStatus   String?
  currentPeriodEnd     DateTime?
  accessExpiresAt      DateTime?
}

// A parent/guardian account -- entirely separate from User (the student),
// with its own session cookie (see lib/parentAuth.ts) so a parent and their
// kid can be logged in simultaneously on the same device. Read-only by
// design: nothing in the parent-facing routes ever writes to a student's
// Progress/PracticeTest/User rows.
model Parent {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  createdAt    DateTime     @default(now())
  links        ParentLink[]
}

// One parent linked to one student. A parent can link multiple students
// (one link row each); a student can be linked to multiple parents (e.g.
// both parents) -- the unique constraint just prevents the same pair from
// being linked twice, not a cap on either side.
model ParentLink {
  id        String   @id @default(cuid())
  parentId  String
  parent    Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([parentId, studentId])
}

model Progress {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subskillId   String
  bestScore    Int
  total        Int
  attempts     Int      @default(1)
  lastAttempt  DateTime @default(now())

  @@unique([userId, subskillId])
}

// A self-reported result from a full-length practice test (e.g. Bluebook or
// an official practice test), used to track section- and domain-level
// progress over time on the analysis page.
model PracticeTest {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  takenAt        DateTime @default(now())
  compositeScore Int
  rwScore        Int
  mathScore      Int
  // Derived from domainCounts below (correct/total * 100), keyed by domain
  // name (see data/curriculum.ts domain names) -- e.g. { "Algebra": 78 }.
  // Domains the student didn't report are simply absent from the object.
  // This is what lib/mastery.ts blends into the analysis page's domain
  // breakdown; kept as a plain percentage there so that code doesn't need
  // to know about raw counts.
  domainScores   Json     @default("{}")
  // What the student actually types in, and what's shown back to them: the
  // literal correct/total question counts Bluebook's own score report shows
  // per domain -- e.g. { "Algebra": { "correct": 11, "total": 13 } }. Kept
  // alongside domainScores (rather than only the derived percentage) so the
  // form and history can round-trip the exact numbers off the student's
  // screen instead of a lossy percentage guess.
  domainCounts   Json     @default("{}")
  createdAt      DateTime @default(now())

  @@index([userId, takenAt])
}
