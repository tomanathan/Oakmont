// Prisma schema for the SAT prep platform.
//
// Local development uses SQLite (zero setup, just a file on disk).
// For production deployment (e.g. Vercel), switch the datasource below to
// Postgres and point DATABASE_URL at a hosted database (Neon, Supabase, etc).
// See README.md for exact steps -- it's a one-line change, not a rewrite,
// because Prisma's query API is the same across both databases.

datasource db {
  provider  = "postgresql"
  // Pooled (pgbouncer, transaction mode) for the app at runtime; migrations
  // use directUrl since pgbouncer's transaction mode doesn't support the
  // session-level features `prisma migrate` needs.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  passwordHash String
  createdAt DateTime   @default(now())
  progress  Progress[]
  practiceTests PracticeTest[]

  // Daily practice streak (consecutive calendar days with at least one quiz
  // submission). Computed in app/api/progress/route.ts on each submission.
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastActiveDate DateTime?

  // Study goals: a baseline score, target score, and SAT test date, used to
  // build a custom-length timeline in place of the default 6-month plan.
  baselineScore  Int?
  goalScore      Int?
  targetTestDate DateTime?

  // Onboarding: null means "never seen the welcome page" (new signups land
  // there once); existing users are backfilled to non-null so they aren't
  // suddenly routed into it. Login timestamps power the "welcome back,
  // here's what you did last time" summary on the dashboard.
  welcomeSeenAt  DateTime?
  lastLoginAt    DateTime?
  previousLoginAt DateTime?

  // Study-streak pet: dies if the student goes 7 days without completing a
  // quiz (see lib/pet.ts). petBornAt resets when a new pet is started after
  // a death; the two "sent" timestamps stop the daily cron from re-sending
  // the same warning/death email more than once.
  petDiedAt              DateTime?
  petBornAt              DateTime  @default(now())
  petWarningEmailSentAt  DateTime?
  petDeathEmailSentAt    DateTime?
}

model Progress {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subskillId   String
  bestScore    Int
  total        Int
  attempts     Int      @default(1)
  lastAttempt  DateTime @default(now())

  @@unique([userId, subskillId])
}

// A self-reported result from a full-length practice test (e.g. Bluebook or
// an official practice test), used to track section- and domain-level
// progress over time on the analysis page.
model PracticeTest {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  takenAt        DateTime @default(now())
  compositeScore Int
  rwScore        Int
  mathScore      Int
  // Optional per-domain estimated score (0-100), keyed by domain name (see
  // data/curriculum.ts domain names) -- e.g. { "Algebra": 78 }. Domains the
  // student didn't report are simply absent from the object.
  domainScores   Json     @default("{}")
  createdAt      DateTime @default(now())

  @@index([userId, takenAt])
}
