# Local development database (SQLite file). Do not change for local dev.
DATABASE_URL="file:./dev.db"

# Secret used to sign session tokens. Generate your own random string before
# deploying anywhere real -- never reuse this example value in production.
# You can generate one with: openssl rand -base64 32
SESSION_SECRET="change-this-to-a-long-random-string"

# Stripe billing. Get the secret key from Dashboard -> Developers -> API
# keys (use a test-mode sk_test_... key for local dev, never a live key).
# Price IDs come from the Product you create in that same Dashboard.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PRICE_ID_MONTHLY="price_..."
STRIPE_PRICE_ID_ANNUAL="price_..."
STRIPE_PRICE_ID_SIXMONTH="price_..."

# Webhook signing secret -- for local dev, run `stripe listen --forward-to
# localhost:3100/api/stripe/webhook` and use the whsec_... it prints; for a
# deployed app, use the signing secret of a webhook endpoint you create in
# the Dashboard pointed at that domain. These are two DIFFERENT secrets.
STRIPE_WEBHOOK_SECRET="whsec_..."
